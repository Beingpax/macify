{
  "name": "macify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/setup-local.mjs --fast",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "ci:check": "npm run cf-typegen && npm run typecheck && npm run lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:initialize:local": "node scripts/initialize-database.mjs --local",
    "db:initialize:production": "node scripts/initialize-database.mjs --production",
    "setup": "node scripts/setup-local.mjs",
    "test:media-validation": "node --experimental-strip-types --test scripts/tests/media-validation.test.mjs",
    "catalogue:validate": "node scripts/validate-catalogue.mjs",
    "catalogue:sync:local": "node scripts/sync-local-catalogue.mjs",
    "readme:generate": "node scripts/generate-readme-apps.mjs",
    "readme:check": "node scripts/generate-readme-apps.mjs --check"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1",
    "decode-ico": "^0.4.1",
    "drizzle-orm": "0.45.2",
    "icojs": "^1.0.1",
    "jose": "^6.2.12",
    "lucide-react": "1.28.0",
    "matter-js": "^0.20.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/matter-js": "^0.20.2",
    "@types/node": "26.1.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.137.0"
  }
}
