{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "macify-local",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "images": {
    "binding": "IMAGES"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "macify-local"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB"
    },
    {
      "binding": "NEXT_TAG_CACHE_D1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "macify-local-media"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "macify-local-media"
    }
  ],
  "ratelimits": [
    {
      "name": "REALTIME_VISITORS_RATE_LIMITER",
      "namespace_id": "748391027",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "APP_ENV": "local",
    "CATALOG_REPOSITORY": "Beingpax/macify",
    "NEXT_INC_CACHE_R2_PREFIX": "next-cache"
  },
  "limits": {
    "cpu_ms": 500
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "env": {
    "production": {
      "name": "macify",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "macify"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "vars": {
        "APP_ENV": "production",
        "ACCESS_AUD": "06d2da1e6c10a11af606ee8f9e47834c2f2824b7dce5f9f0f6c3b418eabb3a4a",
        "CATALOG_REPOSITORY": "Beingpax/macify",
        "NEXT_INC_CACHE_R2_PREFIX": "next-cache"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "macify-production-database",
          "database_id": "603417fc-1404-4bc4-830c-a0532cbeacac"
        },
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "macify-production-database",
          "database_id": "603417fc-1404-4bc4-830c-a0532cbeacac"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "macify-production-media"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "macify-production-media"
        }
      ],
      "ratelimits": [
        {
          "name": "REALTIME_VISITORS_RATE_LIMITER",
          "namespace_id": "748391028",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    }
  }
}
